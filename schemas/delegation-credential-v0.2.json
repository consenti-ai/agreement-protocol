{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://consenti.ai/schemas/delegation-credential-v0.2.json",
  "title": "Consenti Delegation Credential v0.2",
  "description": "Standing, scoped authority from a principal to an agent to commit to terms. Signed by the principal over the RFC 8785 canonical form with signature removed.",
  "type": "object",
  "required": [
    "type",
    "delegation_id",
    "principal",
    "agent",
    "scope",
    "issued_at",
    "expires_at",
    "revocation",
    "signature"
  ],
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "description": "Decimal string. Never a float."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "identifier": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "public_key_ref",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "ES256"
          ],
          "description": "v0.2 reference verifier supports ES256 only; other algorithms fail closed."
        },
        "public_key_ref": {
          "type": "string",
          "description": "MUST be a key the principal controls. For did principals, a fragment of the principal DID."
        },
        "value": {
          "type": "string",
          "description": "base64url ECDSA signature, raw r||s (preferred) or DER."
        }
      }
    }
  },
  "properties": {
    "type": {
      "const": "consenti/delegation/v0.2"
    },
    "profile": {
      "type": "string",
      "description": "Optional namespaced scope profile, e.g. consenti/media-licensing/v0.1. Profiles define action vocabularies; the core spec does not."
    },
    "delegation_id": {
      "type": "string",
      "minLength": 1
    },
    "principal": {
      "type": "object",
      "required": [
        "identifier",
        "commitment"
      ],
      "properties": {
        "identifier": {
          "$ref": "#/$defs/identifier"
        },
        "commitment": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "agent": {
      "type": "object",
      "required": [
        "identifier",
        "public_key_ref"
      ],
      "properties": {
        "identifier": {
          "$ref": "#/$defs/identifier"
        },
        "public_key_ref": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "actions",
        "counterparties"
      ],
      "description": "MUST be present. Unbounded grants use explicit wildcards, never omission.",
      "properties": {
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "counterparties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "max_value": {
          "$ref": "#/$defs/money"
        },
        "aggregate_cap": {
          "type": "object",
          "required": [
            "amount",
            "currency",
            "period"
          ],
          "properties": {
            "amount": {
              "type": "string"
            },
            "currency": {
              "type": "string"
            },
            "period": {
              "type": "string",
              "description": "ISO 8601 duration"
            }
          }
        },
        "prohibited_clauses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires_authorization_above": {
          "$ref": "#/$defs/money"
        }
      }
    },
    "chain_binding": {
      "type": "object",
      "required": [
        "standard",
        "delegation_hash",
        "chain"
      ],
      "properties": {
        "standard": {
          "type": "string"
        },
        "delegation_hash": {
          "type": "string"
        },
        "chain": {
          "type": "string"
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Required. No perpetual delegations."
    },
    "revocation": {
      "type": "object",
      "required": [
        "check_url"
      ],
      "properties": {
        "check_url": {
          "type": "string",
          "format": "uri"
        },
        "anchor_ref": {
          "type": "string"
        }
      }
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  }
}